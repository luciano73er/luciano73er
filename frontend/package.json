{
  "name": "gym-app-frontend",
  "version": "1.0.0",
  "description": "Frontend for Gym Management App with React and TypeScript",
  "private": true,
  "homepage": ".",
  "proxy": "http://localhost:3001",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.2",
    "typescript": "^5.1.6",
    "zustand": "^4.4.0",
    "axios": "^1.4.0",
    "react-icons": "^4.10.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
